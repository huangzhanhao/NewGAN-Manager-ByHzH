# ===============================
# Project Specific
# ===============================

# Application logs
*.log
newgan.log
src/newganmanager/newgan.log

# User configuration and data files (but keep templates)
# Keep the .user directory structure but ignore actual user files
src/newganmanager/.user/*.json
src/newganmanager/.user/*.xml
src/tests/testing_data/.user/*.json
src/tests/testing_data/.user/*.xml
# But keep template files
!src/newganmanager/.user/No Profile.json
!src/newganmanager/.user/default_cfg.json
!src/tests/testing_data/.user/No Profile.json
!src/tests/testing_data/.user/cfg.json

# Runtime generated files
version

# Application config directories (user-specific)
src/newganmanager/.config/
src/tests/testing_data/.config/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.orig

# Cache directories
.cache/
*.cache

# Database files
*.db
*.sqlite
*.sqlite3

# Configuration files with sensitive data
*_local.json
*_private.json
secrets.json

# Environment-specific files (keep .env template)
.env.local
.env.*.local
# But don't ignore the main .env template
!.env

