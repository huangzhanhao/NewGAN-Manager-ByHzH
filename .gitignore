# ===============================
# Project Specific
# ===============================

# Application logs
*.log
newgan.log

# User configuration files
src/newganmanager/.user/*.json
src/newganmanager/.user/*.xml

# 测试夹具数据（含超大 RTF 样本）—— 暂不跟踪，项目重构完成后会重新生成测试代码与测试数据
src/tests/testing_data/

# User RTF exports (personal data, never commit)
src/newganmanager/user_rtf/
user_rtf/

# Portable user data directory (dev runtime output, never commit)
src/newganmanager/data/
# Keep template files
!src/newganmanager/.user/No Profile.json
!src/newganmanager/.user/default_cfg.json

